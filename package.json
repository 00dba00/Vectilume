{
  "name": "vectilume",
  "private": true,
  "description": "Vectilume Icons — free, consistent, themeable SVG icon system",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "test": "turbo run test",
    "request": "node --env-file-if-exists=.env.worker scripts/request.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "version": "0.11.1"
}
