{
  "name": "@vectilume/icons-svg",
  "version": "0.0.0",
  "private": true,
  "description": "Source SVG files for Vectilume Icons",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "hobbies.json",
    "general.json",
    "dist"
  ],
  "exports": {
    "./manifest.json": "./dist/manifest.json",
    "./hobbies.json": "./hobbies.json",
    "./general.json": "./general.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsx ../tooling/src/build-manifest.ts src dist/manifest.json",
    "validate": "tsx ../tooling/src/validate.ts src"
  },
  "devDependencies": {
    "@vectilume/tooling": "workspace:*",
    "tsx": "^4.23.15"
  }
}
