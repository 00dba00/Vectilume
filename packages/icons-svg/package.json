{
  "name": "@vectilume/icons-svg",
  "version": "0.0.0",
  "private": true,
  "description": "Source SVG files for Vectilume Icons",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "hobbies.json",
    "general.json",
    "content.json",
    "lettering.json",
    "food.json",
    "transport.json",
    "dist"
  ],
  "exports": {
    "./manifest.json": "./dist/manifest.json",
    "./hobbies.json": "./hobbies.json",
    "./general.json": "./general.json",
    "./content.json": "./content.json",
    "./lettering.json": "./lettering.json",
    "./food.json": "./food.json",
    "./transport.json": "./transport.json",
    "./release.json": "./release.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsx ../tooling/src/build-manifest.ts src dist/manifest.json",
    "validate": "tsx ../tooling/src/validate.ts src",
    "release": "tsx ../tooling/src/build-release.ts .",
    "visual-diff": "tsx ../tooling/src/visual-diff.ts ."
  },
  "devDependencies": {
    "@vectilume/tooling": "workspace:*",
    "tsx": "^4.23.15"
  }
}
